# Environment template for the LibreOffice MCP HTTP service
# Copy this file to /etc/mcp/mcp-libre-http.env and replace paths as needed.

# The repository root directory containing the mcp-libre project
PROJECT_ROOT=/path/to/mcp-libre

# Python executable to use for the bridge process
PYTHON_EXECUTABLE=python

# HTTP host and port for the MCP streamable HTTP server
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3006
MCP_HTTP_PATH=/mcp

# Optional log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Service user to run the bridge under
SERVICE_USER=your-user
